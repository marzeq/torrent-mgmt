[Unit]
Description=Torrent management daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

User=root
Group=root

WorkingDirectory=/opt/torrent-mgmt

EnvironmentFile=/etc/torrent-mgmt.env

ExecStart=uv run python main.py

Restart=always
RestartSec=10

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/torrent-mgmt

[Install]
WantedBy=multi-user.target
